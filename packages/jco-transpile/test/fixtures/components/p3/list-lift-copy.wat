;; Lists of numbers lifted out of memory: as the results of async exports, and in
;; the items of streams, where what follows a list has to be read from the right
;; place after it. The 16 bytes at 1024 are read as each number type.
(component
  (type $lists (stream (list u8)))
  (type $tuples (stream (tuple (list u8) u32)))
  (type $nested (stream (list (list u16))))

  (core module $mem
    (memory (export "memory") 40)
    (data (i32.const 1024) "\00\00\80\3f\00\00\00\40\00\00\00\00\00\00\f0\3f")
    (data (i32.const 65536) "\01\02\03\04\05")
  )
  (core instance $mem_i (instantiate $mem))
  (alias core export $mem_i "memory" (core memory $memory))

  (core func $u8 (canon task.return (result (list u8)) (memory $memory)))
  (core func $s8 (canon task.return (result (list s8)) (memory $memory)))
  (core func $u16 (canon task.return (result (list u16)) (memory $memory)))
  (core func $s16 (canon task.return (result (list s16)) (memory $memory)))
  (core func $u32 (canon task.return (result (list u32)) (memory $memory)))
  (core func $s32 (canon task.return (result (list s32)) (memory $memory)))
  (core func $u64 (canon task.return (result (list u64)) (memory $memory)))
  (core func $s64 (canon task.return (result (list s64)) (memory $memory)))
  (core func $f32 (canon task.return (result (list f32)) (memory $memory)))
  (core func $f64 (canon task.return (result (list f64)) (memory $memory)))
  (core func $lists_new (canon stream.new $lists))
  (core func $lists_write (canon stream.write $lists async (memory $memory)))
  (core func $lists_return (canon task.return (result $lists)))
  (core func $tuples_new (canon stream.new $tuples))
  (core func $tuples_write (canon stream.write $tuples async (memory $memory)))
  (core func $tuples_return (canon task.return (result $tuples)))
  (core func $nested_new (canon stream.new $nested))
  (core func $nested_write (canon stream.write $nested async (memory $memory)))
  (core func $nested_return (canon task.return (result $nested)))

  (core module $m
    (import "" "memory" (memory 40))
    (import "" "u8" (func $u8 (param i32 i32)))
    (import "" "s8" (func $s8 (param i32 i32)))
    (import "" "u16" (func $u16 (param i32 i32)))
    (import "" "s16" (func $s16 (param i32 i32)))
    (import "" "u32" (func $u32 (param i32 i32)))
    (import "" "s32" (func $s32 (param i32 i32)))
    (import "" "u64" (func $u64 (param i32 i32)))
    (import "" "s64" (func $s64 (param i32 i32)))
    (import "" "f32" (func $f32 (param i32 i32)))
    (import "" "f64" (func $f64 (param i32 i32)))
    (import "" "lists.new" (func $lists_new (result i64)))
    (import "" "lists.write" (func $lists_write (param i32 i32 i32) (result i32)))
    (import "" "lists.return" (func $lists_return (param i32)))
    (import "" "tuples.new" (func $tuples_new (result i64)))
    (import "" "tuples.write" (func $tuples_write (param i32 i32 i32) (result i32)))
    (import "" "tuples.return" (func $tuples_return (param i32)))
    (import "" "nested.new" (func $nested_new (result i64)))
    (import "" "nested.write" (func $nested_write (param i32 i32 i32) (result i32)))
    (import "" "nested.return" (func $nested_return (param i32)))

    (func (export "u8") (result i32) (call $u8 (i32.const 1024) (i32.const 16)) (i32.const 0))
    (func (export "s8") (result i32) (call $s8 (i32.const 1024) (i32.const 16)) (i32.const 0))
    (func (export "u16") (result i32) (call $u16 (i32.const 1024) (i32.const 8)) (i32.const 0))
    (func (export "s16") (result i32) (call $s16 (i32.const 1024) (i32.const 8)) (i32.const 0))
    (func (export "u32") (result i32) (call $u32 (i32.const 1024) (i32.const 4)) (i32.const 0))
    (func (export "s32") (result i32) (call $s32 (i32.const 1024) (i32.const 4)) (i32.const 0))
    (func (export "u64") (result i32) (call $u64 (i32.const 1024) (i32.const 2)) (i32.const 0))
    (func (export "s64") (result i32) (call $s64 (i32.const 1024) (i32.const 2)) (i32.const 0))
    (func (export "f32") (result i32) (call $f32 (i32.const 1024) (i32.const 4)) (i32.const 0))
    (func (export "f64") (result i32) (call $f64 (i32.const 1024) (i32.const 2)) (i32.const 0))

    ;; A new end pair has the read end in the low 32 bits and the write end in the
    ;; high 32.

    ;; Two items at 0: `bytes` bytes at 65536, then none.
    (func (export "open-lists") (param $bytes i32) (result i32)
      (local $ends i64)
      (local.set $ends (call $lists_new))
      (i32.store (i32.const 0) (i32.const 65536))
      (i32.store (i32.const 4) (local.get $bytes))
      (i32.store (i32.const 8) (i32.const 65536))
      (i32.store (i32.const 12) (i32.const 0))
      (drop (call $lists_write
        (i32.wrap_i64 (i64.shr_u (local.get $ends) (i64.const 32)))
        (i32.const 0)
        (i32.const 2)))
      (call $lists_return (i32.wrap_i64 (local.get $ends)))
      (i32.const 0))

    ;; Two items at 0: 4 bytes and 7, then 2 bytes and 9.
    (func (export "open-tuples") (result i32)
      (local $ends i64)
      (local.set $ends (call $tuples_new))
      (i32.store (i32.const 0) (i32.const 1024))
      (i32.store (i32.const 4) (i32.const 4))
      (i32.store (i32.const 8) (i32.const 7))
      (i32.store (i32.const 12) (i32.const 1028))
      (i32.store (i32.const 16) (i32.const 2))
      (i32.store (i32.const 20) (i32.const 9))
      (drop (call $tuples_write
        (i32.wrap_i64 (i64.shr_u (local.get $ends) (i64.const 32)))
        (i32.const 0)
        (i32.const 2)))
      (call $tuples_return (i32.wrap_i64 (local.get $ends)))
      (i32.const 0))

    ;; One item at 0: two lists, at 16, of 2 and 1 u16s.
    (func (export "open-nested") (result i32)
      (local $ends i64)
      (local.set $ends (call $nested_new))
      (i32.store (i32.const 0) (i32.const 16))
      (i32.store (i32.const 4) (i32.const 2))
      (i32.store (i32.const 16) (i32.const 1024))
      (i32.store (i32.const 20) (i32.const 2))
      (i32.store (i32.const 24) (i32.const 1028))
      (i32.store (i32.const 28) (i32.const 1))
      (drop (call $nested_write
        (i32.wrap_i64 (i64.shr_u (local.get $ends) (i64.const 32)))
        (i32.const 0)
        (i32.const 1)))
      (call $nested_return (i32.wrap_i64 (local.get $ends)))
      (i32.const 0))

    (func (export "cb") (param i32 i32 i32) (result i32) (i32.const 0))
  )
  (core instance $i (instantiate $m (with "" (instance
    (export "memory" (memory $memory))
    (export "u8" (func $u8))
    (export "s8" (func $s8))
    (export "u16" (func $u16))
    (export "s16" (func $s16))
    (export "u32" (func $u32))
    (export "s32" (func $s32))
    (export "u64" (func $u64))
    (export "s64" (func $s64))
    (export "f32" (func $f32))
    (export "f64" (func $f64))
    (export "lists.new" (func $lists_new))
    (export "lists.write" (func $lists_write))
    (export "lists.return" (func $lists_return))
    (export "tuples.new" (func $tuples_new))
    (export "tuples.write" (func $tuples_write))
    (export "tuples.return" (func $tuples_return))
    (export "nested.new" (func $nested_new))
    (export "nested.write" (func $nested_write))
    (export "nested.return" (func $nested_return))
  ))))

  (type $get_u8 (func async (result (list u8))))
  (type $get_s8 (func async (result (list s8))))
  (type $get_u16 (func async (result (list u16))))
  (type $get_s16 (func async (result (list s16))))
  (type $get_u32 (func async (result (list u32))))
  (type $get_s32 (func async (result (list s32))))
  (type $get_u64 (func async (result (list u64))))
  (type $get_s64 (func async (result (list s64))))
  (type $get_f32 (func async (result (list f32))))
  (type $get_f64 (func async (result (list f64))))
  (type $open_lists (func async (param "bytes" u32) (result $lists)))
  (type $open_tuples (func async (result $tuples)))
  (type $open_nested (func async (result $nested)))
  (func (export "get-u8") (type $get_u8) (canon lift (core func $i "u8") async (memory $memory) (callback (core func $i "cb"))))
  (func (export "get-s8") (type $get_s8) (canon lift (core func $i "s8") async (memory $memory) (callback (core func $i "cb"))))
  (func (export "get-u16") (type $get_u16) (canon lift (core func $i "u16") async (memory $memory) (callback (core func $i "cb"))))
  (func (export "get-s16") (type $get_s16) (canon lift (core func $i "s16") async (memory $memory) (callback (core func $i "cb"))))
  (func (export "get-u32") (type $get_u32) (canon lift (core func $i "u32") async (memory $memory) (callback (core func $i "cb"))))
  (func (export "get-s32") (type $get_s32) (canon lift (core func $i "s32") async (memory $memory) (callback (core func $i "cb"))))
  (func (export "get-u64") (type $get_u64) (canon lift (core func $i "u64") async (memory $memory) (callback (core func $i "cb"))))
  (func (export "get-s64") (type $get_s64) (canon lift (core func $i "s64") async (memory $memory) (callback (core func $i "cb"))))
  (func (export "get-f32") (type $get_f32) (canon lift (core func $i "f32") async (memory $memory) (callback (core func $i "cb"))))
  (func (export "get-f64") (type $get_f64) (canon lift (core func $i "f64") async (memory $memory) (callback (core func $i "cb"))))
  (func (export "open-lists") (type $open_lists) (canon lift (core func $i "open-lists") async (callback (core func $i "cb"))))
  (func (export "open-tuples") (type $open_tuples) (canon lift (core func $i "open-tuples") async (callback (core func $i "cb"))))
  (func (export "open-nested") (type $open_nested) (canon lift (core func $i "open-nested") async (callback (core func $i "cb"))))
)
