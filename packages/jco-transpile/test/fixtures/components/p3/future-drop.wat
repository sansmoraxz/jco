;; A guest writing to a future and a stream of `own<thing>`, and dropping a future
;; it is given. `write-result` is what the last write came to: -2 while pending,
;; else its copy result as the canonical ABI gives it.
(component
  (import "test:host/things" (instance $host
    (export "thing" (type (sub resource)))
    (export "[constructor]thing" (func (result (own 0))))
  ))
  (alias export $host "thing" (type $thing))
  (alias export $host "[constructor]thing" (func $new))
  (type $f (future (own $thing)))
  (type $s (stream (own $thing)))
  (core module $mem (memory (export "memory") 1))
  (core instance $mem_i (instantiate $mem))
  (alias core export $mem_i "memory" (core memory $memory))
  (core func $new_l (canon lower (func $new)))
  (core func $thing_drop (canon resource.drop $thing))
  (core func $future_new (canon future.new $f))
  (core func $future_write (canon future.write $f async (memory $memory)))
  (core func $future_drop_w (canon future.drop-writable $f))
  (core func $future_drop_r (canon future.drop-readable $f))
  (core func $stream_new (canon stream.new $s))
  (core func $stream_write (canon stream.write $s async (memory $memory)))
  (core func $stream_drop_w (canon stream.drop-writable $s))
  (core func $set_new (canon waitable-set.new))
  (core func $join (canon waitable.join))
  (core func $ret_f (canon task.return (result $f)))
  (core func $ret_s (canon task.return (result $s)))
  (core func $ret_none (canon task.return))
  (core module $m
    (import "" "memory" (memory 1))
    (import "" "new" (func $new (result i32)))
    (import "" "thing.drop" (func $thing_drop (param i32)))
    (import "" "future.new" (func $future_new (result i64)))
    (import "" "future.write" (func $future_write (param i32 i32) (result i32)))
    (import "" "future.drop-writable" (func $future_drop_w (param i32)))
    (import "" "future.drop-readable" (func $future_drop_r (param i32)))
    (import "" "stream.new" (func $stream_new (result i64)))
    (import "" "stream.write" (func $stream_write (param i32 i32 i32) (result i32)))
    (import "" "stream.drop-writable" (func $stream_drop_w (param i32)))
    (import "" "waitable-set.new" (func $set_new (result i32)))
    (import "" "waitable.join" (func $join (param i32 i32)))
    (import "" "ret.future" (func $ret_f (param i32)))
    (import "" "ret.stream" (func $ret_s (param i32)))
    (import "" "ret.none" (func $ret_none))
    (global $w (mut i32) (i32.const 0))
    (global $set (mut i32) (i32.const 0))
    (global $result (mut i32) (i32.const -2))
    (global $is_stream (mut i32) (i32.const 0))
    (global $held (mut i32) (i32.const 0))

    (func $wait (result i32)
      (if (i32.eqz (global.get $set)) (then (global.set $set (call $set_new))))
      (call $join (global.get $w) (global.get $set))
      (i32.or (i32.const 2) (i32.shl (global.get $set) (i32.const 4))))

    ;; After a write came to `r`: gives the writable end up.
    (func $finish (param $r i32)
      (global.set $result (local.get $r))
      (if (global.get $is_stream)
        (then (call $stream_drop_w (global.get $w)))
        (else (call $future_drop_w (global.get $w)))))

    (func $start_future_write (result i32)
      (local $r i32)
      (i32.store (i32.const 0) (call $new))
      (local.set $r (call $future_write (global.get $w) (i32.const 0)))
      (if (result i32) (i32.eq (local.get $r) (i32.const -1))
        (then (call $wait))
        (else (call $finish (local.get $r)) (i32.const 0))))

    ;; open-future(write-now) -> future<own<thing>>
    (func (export "open-future") (param $now i32) (result i32)
      (local $ends i64)
      (local.set $ends (call $future_new))
      (global.set $w (i32.wrap_i64 (i64.shr_u (local.get $ends) (i64.const 32))))
      (global.set $is_stream (i32.const 0))
      (global.set $result (i32.const -2))
      (call $ret_f (i32.wrap_i64 (local.get $ends)))
      (if (result i32) (local.get $now)
        (then (call $start_future_write))
        (else (i32.const 0))))

    ;; prepare(write-now): the same, keeping the read end for take-future.
    (func (export "prepare") (param $now i32) (result i32)
      (local $ends i64)
      (local.set $ends (call $future_new))
      (global.set $w (i32.wrap_i64 (i64.shr_u (local.get $ends) (i64.const 32))))
      (global.set $held (i32.wrap_i64 (local.get $ends)))
      (global.set $is_stream (i32.const 0))
      (global.set $result (i32.const -2))
      (call $ret_none)
      (if (result i32) (local.get $now)
        (then (call $start_future_write))
        (else (i32.const 0))))

    (func (export "take-future") (result i32) (global.get $held))

    ;; write-future(): starts the write on what open-future(false) opened.
    (func (export "write-future") (result i32)
      (call $ret_none)
      (call $start_future_write))

    ;; open-stream() -> stream<own<thing>>, with one thing written to it.
    (func (export "open-stream") (result i32)
      (local $ends i64) (local $r i32)
      (local.set $ends (call $stream_new))
      (global.set $w (i32.wrap_i64 (i64.shr_u (local.get $ends) (i64.const 32))))
      (global.set $is_stream (i32.const 1))
      (global.set $result (i32.const -2))
      (i32.store (i32.const 0) (call $new))
      (call $ret_s (i32.wrap_i64 (local.get $ends)))
      (local.set $r (call $stream_write (global.get $w) (i32.const 0) (i32.const 1)))
      (if (result i32) (i32.eq (local.get $r) (i32.const -1))
        (then (call $wait))
        (else (call $finish (local.get $r)) (i32.const 0))))

    ;; open-stream-idle() -> stream<own<thing>>, with nothing written yet.
    (func (export "open-stream-idle") (result i32)
      (local $ends i64)
      (local.set $ends (call $stream_new))
      (global.set $w (i32.wrap_i64 (i64.shr_u (local.get $ends) (i64.const 32))))
      (global.set $is_stream (i32.const 1))
      (global.set $result (i32.const -2))
      (call $ret_s (i32.wrap_i64 (local.get $ends)))
      (i32.const 0))

    ;; write-stream(): writes to what open-stream-idle opened.
    (func (export "write-stream") (result i32)
      (local $r i32)
      (call $ret_none)
      (i32.store (i32.const 0) (call $new))
      (local.set $r (call $stream_write (global.get $w) (i32.const 0) (i32.const 1)))
      (if (result i32) (i32.eq (local.get $r) (i32.const -1))
        (then (call $wait))
        (else (call $finish (local.get $r)) (i32.const 0))))

    ;; A write ending: the event's third argument is its result.
    (func (export "cb") (param $event i32) (param $p1 i32) (param $p2 i32) (result i32)
      (call $finish (local.get $p2))
      (i32.const 0))

    (func (export "write-result") (result i32) (global.get $result))

    ;; The handle written, which is still the guest's if the write did not copy it.
    (func (export "drop-written") (call $thing_drop (i32.load (i32.const 0))))

    ;; discard(f): drops the future it is given, unread.
    (func (export "discard") (param $f i32) (result i32)
      (call $future_drop_r (local.get $f))
      (call $ret_none)
      (i32.const 0))
  )
  (core instance $i (instantiate $m (with "" (instance
    (export "memory" (memory $memory))
    (export "new" (func $new_l))
    (export "thing.drop" (func $thing_drop))
    (export "future.new" (func $future_new))
    (export "future.write" (func $future_write))
    (export "future.drop-writable" (func $future_drop_w))
    (export "future.drop-readable" (func $future_drop_r))
    (export "stream.new" (func $stream_new))
    (export "stream.write" (func $stream_write))
    (export "stream.drop-writable" (func $stream_drop_w))
    (export "waitable-set.new" (func $set_new))
    (export "waitable.join" (func $join))
    (export "ret.future" (func $ret_f))
    (export "ret.stream" (func $ret_s))
    (export "ret.none" (func $ret_none))
  ))))
  (type $open_future (func async (param "write-now" bool) (result $f)))
  (type $write_future (func async))
  (type $open_stream (func async (result $s)))
  (type $discard (func async (param "f" $f)))
  (func (export "open-future") (type $open_future)
    (canon lift (core func $i "open-future") async (callback (core func $i "cb"))))
  (type $prepare (func async (param "write-now" bool)))
  (func (export "prepare") (type $prepare)
    (canon lift (core func $i "prepare") async (callback (core func $i "cb"))))
  (func (export "take-future") (result $f) (canon lift (core func $i "take-future")))
  (func (export "write-future") (type $write_future)
    (canon lift (core func $i "write-future") async (callback (core func $i "cb"))))
  (func (export "open-stream-idle") (type $open_stream)
    (canon lift (core func $i "open-stream-idle") async (callback (core func $i "cb"))))
  (func (export "write-stream") (type $write_future)
    (canon lift (core func $i "write-stream") async (callback (core func $i "cb"))))
  (func (export "open-stream") (type $open_stream)
    (canon lift (core func $i "open-stream") async (callback (core func $i "cb"))))
  (func (export "discard") (type $discard)
    (canon lift (core func $i "discard") async (callback (core func $i "cb"))))
  (func (export "write-result") (result s32) (canon lift (core func $i "write-result")))
  (func (export "drop-written") (canon lift (core func $i "drop-written")))
)
